{
  "name": "@nudge/server",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "dev": "NODE_ENV=development tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "dev:init-data": "tsx --env-file=../../.env src/auth/dev-init-data.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "grammy": "1.46.0",
    "pg-boss": "12.31.0",
    "pino": "10.3.1",
    "prisma": "7.10.0",
    "zod": "4.6.2",
    "@nudge/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.13.4",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  }
}
