{
  "name": "@nudge/server",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm db:generate && tsc --project tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "NODE_ENV=development tsx watch --env-file=../../.env src/index.ts",
    "build": "pnpm db:generate && tsc --project tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "db:migrate": "node --env-file=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "node --env-file=../../.env node_modules/prisma/build/index.js studio",
    "predev": "pnpm db:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "grammy": "1.46.0",
    "pg-boss": "12.31.0",
    "pino": "10.3.1",
    "prisma": "7.10.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.13.4",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  }
}
