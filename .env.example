# Postgres connection URL
DATABASE_URL=
# Telegram bot token
BOT_TOKEN=
# Maximum Telegram initData age in seconds
AUTH_MAX_AGE_SECONDS=86400
# Bot mode: polling|webhook
BOT_MODE=polling
# Public Telegram webhook URL
WEBHOOK_URL=
# Telegram webhook verification secret
WEBHOOK_SECRET=
# Server listen port
PORT=3000
# Public Mini App URL
MINIAPP_URL=
# AI provider: none|anthropic
AI_PROVIDER=none
# Anthropic API key when enabled
ANTHROPIC_API_KEY=
# Application log level
LOG_LEVEL=info
